# Required: official DeepSeek API credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Server. The recommended one-line startup is: docker compose up --build
CAPYREVIEW_HOST=127.0.0.1
CAPYREVIEW_PORT=8080
CAPYREVIEW_MAX_DIFF_BYTES=1048576

# Docker Compose injects the required PostgreSQL and Redis URLs into the app.
# Direct host execution must set CAPYREVIEW_DATABASE_URL and CAPYREVIEW_REDIS_URL.
CAPYREVIEW_QUEUE_MAX_ATTEMPTS=3
CAPYREVIEW_QUEUE_LEASE_SECONDS=60

# GitHub Webhook + official remote GitHub MCP. The same PAT is reused.
CAPYREVIEW_GITHUB_WEBHOOK_SECRET=
CAPYREVIEW_GITHUB_TOKEN=
CAPYREVIEW_AUTO_POST_REVIEW=false
CAPYREVIEW_WEBHOOK_MAX_AGE_SECONDS=600

# Runtime Harness and bounded reviewer loops.
CAPYREVIEW_MAX_STEPS=8
CAPYREVIEW_TIMEOUT_SECONDS=120
CAPYREVIEW_AGENT_MAX_WORKERS=2
CAPYREVIEW_AGENT_RETRIES=1
CAPYREVIEW_AGENT_LOOP_MAX_STEPS=4

# Context compression and cross-task memory.
CAPYREVIEW_CONTEXT_MAX_TOKENS=12000
CAPYREVIEW_CONTEXT_RESERVED_TOKENS=2500
CAPYREVIEW_MEMORY_ENABLED=true
CAPYREVIEW_MEMORY_RECALL_LIMIT=6
CAPYREVIEW_MEMORY_WORKING_TTL_SECONDS=86400

# Formal Review Skill validation and holdout activation gates.
CAPYREVIEW_EVAL_MAX_CASES=5
CAPYREVIEW_EVAL_MIN_CASES=3
CAPYREVIEW_EVAL_MIN_HOLDOUT_CASES=2
CAPYREVIEW_EVAL_MIN_IMPROVEMENT=0.01
CAPYREVIEW_EVAL_MAX_METRIC_REGRESSION=0
