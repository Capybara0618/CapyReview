+
+class ArrayPredicateType(Enum):
+    EXACT = "EXACT"
+    MATCH = "MATCH"
+    GLOB = "GLOB"
+    RE = "RE"
+
+
+class ArrayPredicateCombinator(Enum):
+    AND = "AND"
+    OR = "OR"
