+def test_unhasbable_generic_alias() -> None:
+    """https://github.com/pydantic/pydantic/issues/13645"""
+
+    class Meta:
+        __hash__ = None
+
+    ta = TypeAdapter(list[Annotated[int, Meta()]])
+
+    assert ta.validate_python(['1']) == [1]
